# HealthSense AI Backend — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# USAGE:
#   1. Copy this file to .env (never commit .env to version control)
#   2. Fill in production values before deployment
#   3. For local LAN development, the defaults below work as-is — no .env needed.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Secret Key ──────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Leave default for local development only.
DJANGO_SECRET_KEY=django-insecure-healthsense-ai-local-dev-key-change-in-prod

# ─── Debug Mode ──────────────────────────────────────────────────────────────
# Development: True (default — shows detailed errors, enables debug toolbar)
# Production:  False (MUST be False before deploying — hides stack traces)
DEBUG=True

# ─── Allowed Hosts ───────────────────────────────────────────────────────────
# Development: * (default — allows Android emulator/LAN device connections)
# Production:  Comma-separated explicit hosts, e.g.:
#   ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com
ALLOWED_HOSTS=*

# ─── CORS (Cross-Origin Resource Sharing) ────────────────────────────────────
# Development: Leave unset (defaults to CORS_ALLOW_ALL_ORIGINS=True for Android LAN access)
# Production:  Set comma-separated allowed origins, e.g.:
#   CORS_ALLOWED_ORIGINS_LIST=https://yourapp.com,https://admin.yourapp.com
# When set, CORS_ALLOW_ALL_ORIGINS is automatically disabled.
CORS_ALLOWED_ORIGINS_LIST=

# ─── Django Server Port ──────────────────────────────────────────────────────
PORT=8000
