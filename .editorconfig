# ==============================================================================
# HealthSense AI — EditorConfig
# Ensures uniform formatting across Android Studio, VS Code, and other editors.
# ==============================================================================

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Java & Android XML
[*.java]
indent_size = 4

[*.xml]
indent_size = 4

# Python PEP 8
[*.py]
indent_size = 4
max_line_length = 120

# YAML & JSON
[*.{yaml,yml,json}]
indent_size = 2

# Markdown documentation
[*.md]
trim_trailing_whitespace = false
insert_final_newline = true

# Batch scripts
[*.{bat,cmd}]
end_of_line = crlf
