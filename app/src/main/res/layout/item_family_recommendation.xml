<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/surface"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Avatar & Name + Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_rec_member_avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_pill_badge"
                android:backgroundTint="@color/primary_container"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="JD"
                android:textColor="@color/primary_dark"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_rec_member_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    tools:text="John Doe" />

                <TextView
                    android:id="@+id/tv_rec_member_health_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="Diabetes, Hypertension" />
            </LinearLayout>
        </LinearLayout>

        <!-- Recommendation Status Banner -->
        <LinearLayout
            android:id="@+id/layout_status_badge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_status_suitable"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <ImageView
                android:id="@+id/iv_status_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Status"
                android:src="@drawable/ic_check_circle"
                app:tint="@color/status_suitable" />

            <TextView
                android:id="@+id/tv_recommendation_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/status_suitable_text"
                android:textSize="14sp"
                tools:text="SUITABLE" />

            <TextView
                android:id="@+id/tv_risk_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/status_suitable_text"
                android:textSize="12sp"
                tools:text="Risk: Low" />
        </LinearLayout>

        <!-- Why Reason Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-bold"
            android:text="@string/label_why"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_why_reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:lineSpacingMultiplier="1.2"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="Nutrient levels are well within safe thresholds for general dietary health with no flagged allergens detected." />

        <!-- Key Factors Breakdown -->
        <TextView
            android:id="@+id/tv_factors_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-bold"
            android:text="@string/label_key_factors"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_health_factors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="2"
            tools:listitem="@layout/item_health_factor" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
