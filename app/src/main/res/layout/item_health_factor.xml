<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:background="@drawable/bg_nutrition_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/iv_factor_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="Factor impact"
        android:src="@drawable/ic_warning"
        app:tint="@color/status_caution" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_factor_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            tools:text="High Sugar Content" />

        <TextView
            android:id="@+id/tv_factor_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="sans-serif"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            tools:text="14.2g per serving exceeds standard diabetic guideline (&lt;5g)." />
    </LinearLayout>
</LinearLayout>
