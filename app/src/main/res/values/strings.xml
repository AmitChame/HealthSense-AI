    <!-- Medical Disclaimer -->
    <string name="medical_disclaimer_title">Medical Disclaimer</string>
    <string name="medical_disclaimer_content">HealthSense AI provides informational food-health guidance based on standard packaged nutritional data and algorithmic health profile mapping. It is NOT a medical device, diagnosis system, or substitute for professional medical, clinical, or dietary advice. Always consult a qualified physician or healthcare provider regarding clinical diets, severe allergies, or medical conditions.</string>
    <string name="privacy_policy_title">Privacy &amp; Data Notice</string>
    <string name="privacy_policy_content">Your health profile and family health data are scoped exclusively to your authenticated Firebase user ID and stored securely in Cloud Firestore. HealthSense AI does not sell or share personal health records with third parties.</string>

