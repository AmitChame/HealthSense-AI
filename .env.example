# HealthSense AI — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env (do NOT commit .env to version control):
#      cp .env.example .env
# 2. Update the values below for your environment.
# 3. For local development on LAN or Android emulator, the default values below
#    work out of the box without changes.
# ==============================================================================

# ─── Django Core Settings ─────────────────────────────────────────────────────
# In production, set to False. Shows detailed debug pages if True.
DEBUG=True

# Secret key used for cryptographic signing. Generate a strong key for production:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=django-insecure-healthsense-ai-local-dev-key-change-in-prod

# ─── Allowed Hosts ────────────────────────────────────────────────────────────
# In development: '*' permits Android emulator (10.0.2.2) and LAN devices to connect.
# In production: comma-separated list of explicit hostnames/domains.
# Example: ALLOWED_HOSTS=api.healthsense.example.com,localhost,127.0.0.1
ALLOWED_HOSTS=*

# ─── CORS (Cross-Origin Resource Sharing) ─────────────────────────────────────
# In development: leaving this unset allows all origins (required for mobile clients).
# In production: comma-separated list of allowed web origins.
# Example: CORS_ALLOWED_ORIGINS_LIST=https://healthsense.example.com
CORS_ALLOWED_ORIGINS_LIST=

# ─── Server Configuration ─────────────────────────────────────────────────────
PORT=8000

# ─── Open Food Facts Attribution & User-Agent ─────────────────────────────────
# Open Food Facts asks API consumers to provide a descriptive User-Agent header.
OPEN_FOOD_FACTS_USER_AGENT=HealthSenseAI/1.0 (academic MCA mini-project; contact: amitchame19@gmail.com)
